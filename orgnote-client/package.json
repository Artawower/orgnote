{
  "name": "orgnote-client",
  "version": "0.68.7",
  "description": "Org Roam implementation for web and mobile devices.",
  "productName": "orgnote",
  "author": "OrgNote <app.orgnote@gmail.com>",
  "license": "GPL-3.0",
  "type": "module",
  "private": false,
  "scripts": {
    "dev": "env-cmd -f ./.env quasar dev",
    "dev:no-cache": "rm -rf node_modules && bun install && bun run dev",
    "dev:remote": "env-cmd -f ./.env.prod quasar dev",
    "dev:android": "env-cmd -f ./.env quasar dev -m capacitor -T android",
    "dev:android:local": "adb reverse tcp:8000 tcp:8000 && adb reverse tcp:3000 tcp:3000 && env-cmd -f ./.env quasar dev -m capacitor -T android",
    "dev:pwa": "env-cmd -f ./.env quasar dev -m pwa",
    "setup:certs": "./scripts/setup-local-certs.sh",
    "setup:macos-signing-cert": "./scripts/create-macos-signing-cert.sh",
    "dev:pwa:preview": "env-cmd -f ./.env quasar build -m pwa && node node_modules/@quasar/cli/bin/quasar.js serve dist/pwa --https --cert .certs/cert.pem --key .certs/key.pem --port 3001 --hostname localhost --history",
    "dev:ssr": "quasar dev -m ssr",
    "dev:android:remote": "env-cmd -f ./.env.prod quasar dev -m capacitor -T android -- -d",
    "dev:android:remote-proxy": "env-cmd -f ./.env.prod.localdev quasar dev -m capacitor -T android -- -d",
    "dev:ios": "env-cmd -f ./.env.ios quasar dev -m capacitor -T ios",
    "dev:ios:local": "env-cmd -f ./.env quasar dev -m capacitor -T ios",
    "dev:ios:remote": "env-cmd -f ./.env.prod quasar dev -m capacitor -T ios -- --target=\"iPhone-15-Pro\"",
    "dev:ios-tablet:remote": "env-cmd -f ./.env.prod quasar dev -m capacitor -T ios -- --target=\"iPad-10th-generation\"",
    "dev:electron": "env-cmd -f ./.env quasar dev -m electron",
    "dev:electron:remote": "env-cmd -f ./.env.prod quasar dev -m electron",
    "dev:ssr:build": "env-cmd -f ./.env.ssr node ./dist/ssr/index.js",
    "dev:pwa:remote": "npm run build:pwa && docker compose -f ./deploy/docker-compose.pwa.yaml up",
    "clean:android": "cd src-capacitor/android && ./gradlew clean && ./gradlew build --refresh-dependencies",
    "build": "quasar build",
    "build:ssr": "env-cmd -f ./.env.prod bun run build -m ssr",
    "build:electron": "env-cmd -f ./.env.prod bun run build -m electron",
    "build:all": "bun run build:pwa && bun run build:android:aab",
    "build:pwa": "env-cmd -f ./.env.prod quasar build -m pwa",
    "build:pwa:dev": "VITE_SOURCEMAP=true env-cmd -f ./.env.prod quasar build -m pwa",
    "build:android": "env-cmd -f ./.env.prod quasar build -m capacitor -T android -- assembleRelease bundleRelease",
    "build:android:aab": "./deploy/sync-capaticor-version.sh && bun run build:android",
    "build:ios": "env-cmd -f ./.env.prod quasar build -m capacitor -T ios",
    "report:duplicates": "jscpd ./src",
    "lint": "NODE_OPTIONS='--max-old-space-size=8192' eslint -c ./eslint.config.js \"./src/**/*.{ts,js,cjs,mjs,vue}\"",
    "test": "vitest",
    "test:ci": "vitest run",
    "generate:icons": "bash scripts/generate-icons.sh",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/device": "7.0.2",
    "@capacitor/inappbrowser": "^3.0.0",
    "@capacitor/keyboard": "7.0.1",
    "@codemirror/autocomplete": "6.20.0",
    "@codemirror/commands": "6.10.1",
    "@codemirror/language": "6.12.1",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "6.5.3",
    "@codemirror/view": "6.39.5",
    "@es-git/fetch-mixin": "0.10.0",
    "@es-git/load-as-mixin": "0.10.0",
    "@es-git/memory-repo": "0.10.0",
    "@es-git/mix": "0.10.0",
    "@es-git/object-mixin": "0.10.0",
    "@es-git/walkers-mixin": "0.10.0",
    "@highlightjs/vue-plugin": "2.1.0",
    "@hsorby/vue3-katex": "0.6.0-rc.7",
    "@lezer/common": "1.5.0",
    "@pinojs/redact": "0.4.0",
    "@quasar/cli": "2.5.0",
    "@quasar/extras": "1.18.0",
    "@uiw/codemirror-extensions-langs": "4.25.4",
    "@uiw/codemirror-theme-github": "^4.25.4",
    "@vueuse/core": "13.1.0",
    "axios": "1.8.4",
    "better-queue": "3.8.12",
    "chokidar": "5.0.0",
    "date-fns": "4.1.0",
    "dexie": "4.0.11",
    "diff-match-patch": "1.0.5",
    "dompurify": "3.3.1",
    "echarts": "6.1.0",
    "electron-updater": "^6.8.9",
    "fast-deep-equal": "3.1.3",
    "flexsearch": "0.8.212",
    "force-graph": "1.43.5",
    "fuse.js": "7.1.0",
    "highlight.js": "^11.11.1",
    "katex": "0.16.27",
    "medium-zoom": "1.1.0",
    "neverthrow": "8.2.0",
    "notiwind": "2.1.0",
    "org-mode-ast": "0.13.5",
    "orgnote-api": "0.67.2",
    "partysocket": "1.1.6",
    "pinia": "3.0.2",
    "pinia-plugin-persistedstate": "4.2.0",
    "quasar": "2.18.1",
    "register-service-worker": "1.7.2",
    "rfdc": "1.4.1",
    "setimmediate": "1.0.5",
    "smol-toml": "1.5.2",
    "spectrallogs": "0.2.2",
    "splitpanes": "4.0.3",
    "toad-scheduler": "3.1.0",
    "util": "0.12.5",
    "uuid": "11.1.0",
    "valibot": "1.0.0",
    "vue": "3.5.13",
    "vue-highlight-words": "3.0.1",
    "vue-i18n": "11.1.3",
    "vue-router": "4.5.0",
    "vue-select": "4.0.0-beta.6",
    "vue3-easy-data-table": "1.5.47"
  },
  "devDependencies": {
    "@capacitor/status-bar": "7.0.1",
    "@chromatic-com/storybook": "^4.1.3",
    "@electron/packager": "^18.3.6",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "9.7.0",
    "@hugotomazi/capacitor-navigation-bar": "4.0.1",
    "@intlify/unplugin-vue-i18n": "6.0.8",
    "@pinia/testing": "1.0.1",
    "@quasar/app-vite": "2.2.0",
    "@quasar/icongenie": "6.1.0",
    "@storybook/addon-docs": "10.1.2",
    "@storybook/addon-onboarding": "^10.1.2",
    "@storybook/vue3-vite": "^10.1.2",
    "@types/better-queue": "3.8.6",
    "@types/bun": "1.2.10",
    "@types/diff-match-patch": "^1.0.36",
    "@types/dompurify": "3.2.0",
    "@types/fast-redact": "3.0.4",
    "@types/node": "22.14.1",
    "@types/setimmediate": "1.0.4",
    "@types/splitpanes": "2.2.6",
    "@types/uuid": "10.0.0",
    "@vitejs/plugin-vue": "5.2.3",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.7.0",
    "@vue/language-server": "2.2.12",
    "@vue/test-utils": "2.4.6",
    "@vue/typescript-plugin": "3.1.5",
    "autoprefixer": "10.4.21",
    "baseline-browser-mapping": "^2.9.14",
    "electron": "35.2.0",
    "electron-builder": "^26.15.3",
    "env-cmd": "10.1.0",
    "eslint": "10.4.0",
    "eslint-plugin-sonarjs": "4.0.3",
    "eslint-plugin-storybook": "^10.4.0",
    "eslint-plugin-vue": "10.9.1",
    "fake-indexeddb": "6.0.0",
    "globals": "16.0.0",
    "happy-dom": "17.4.4",
    "husky": "9.1.7",
    "jscpd": "4.0.5",
    "linkedom": "0.18.9",
    "prettier": "3.5.3",
    "storybook": "^10.1.2",
    "typescript": "5.8.3",
    "vite": "6.3.2",
    "vite-plugin-checker": "0.13.0",
    "vitest": "3.1.2",
    "vue-tsc": "2.2.8",
    "workbox-build": "^7.3.0",
    "workbox-cacheable-response": "^7.3.0",
    "workbox-core": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "7.3.0",
    "workbox-strategies": "7.3.0"
  },
  "overrides": {
    "@lezer/common": "1.5.0"
  },
  "jscpd": {
    "threshold": 1.65,
    "reporters": [
      "html",
      "console"
    ],
    "format": [
      "typescript"
    ],
    "ignore": [
      "**/__snapshots__/**",
      "**/.git/**",
      "**/*.spec.ts",
      "**/node_modules/**",
      "**/dist/**",
      "**/generated/**"
    ],
    "minLines": 3,
    "minTokens": 50,
    "ignorePattern": [
      "import.*from\\s*'.*'",
      "export.*from\\s*'.*'"
    ],
    "output": "./dist/duplication-report/",
    "absolute": true,
    "blame": true,
    "gitignore": true
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
